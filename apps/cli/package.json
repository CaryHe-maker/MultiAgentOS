{
  "name": "@multiagentos/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@multiagentos/contracts": "workspace:*",
    "@multiagentos/user-interaction": "workspace:*",
    "commander": "15.0.0",
    "ink": "8.0.0",
    "react": "19.3.1",
    "string-width": "8.3.0",
    "wrap-ansi": "10.0.2"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --pretty false",
    "check": "tsc -b tsconfig.json --pretty false"
